# Copy this file to .env and fill in your own values.
# The real .env file is in .gitignore so it never goes to GitHub.

# A long random string used to sign session cookies.
# Make one with:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Keep this as 0. Debug mode shows code and errors in the browser.
FLASK_DEBUG=0
